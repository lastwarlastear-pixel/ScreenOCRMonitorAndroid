<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingBarRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_bar"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Drag Handle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="8dp"
        android:text="⋮⋮"
        android:textColor="#88FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Start / Stop Toggle -->
    <ImageButton
        android:id="@+id/btnFloatingToggle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_play"
        android:contentDescription="Start/Stop Monitoring" />

    <!-- Silence Alarm Button (Lights up when ringing) -->
    <ImageButton
        android:id="@+id/btnFloatingSilence"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_silence"
        android:visibility="gone"
        android:contentDescription="Silence Alarm" />

    <!-- Toggle Region Border Button -->
    <ImageButton
        android:id="@+id/btnFloatingCrop"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_crop"
        android:contentDescription="Toggle Region Box" />

    <!-- Exit App Button -->
    <ImageButton
        android:id="@+id/btnFloatingExit"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="Exit App" />

    <!-- Status and OCR Info -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFloatingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFloatingOcrPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="200dp"
            android:text="No text yet..."
            android:textColor="#BBFFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
